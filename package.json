{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "veles": "1.1.1"
  },
  "devDependencies": {
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "6.0.3",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,jsonc,css}": [
      "oxfmt --write"
    ]
  }
}
